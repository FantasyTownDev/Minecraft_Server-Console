@page "/error/{statusCode?}"
@model ErrorModel
@{
    ViewData["Title"] = $"错误 {Model.StatusCode}";
    Layout = null;
}

<!DOCTYPE html>
<html lang="zh-cn">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - F-MCSC</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700;900&family=JetBrains+Mono:wght@400;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/Error.css" asp-append-version="true" />
</head>
<body>

    <!-- Dirt 背景 -->
    <div class="dirt-bg"></div>

    <!-- 错误容器 -->
    <div class="error-container">
        <!-- 角标 - 红色警戒风格 -->
        <div class="corner corner-tl"></div>
        <div class="corner corner-tr"></div>
        <div class="corner corner-bl"></div>
        <div class="corner corner-br"></div>

        <!-- TNT 风格错误图标 -->
        <div class="error-tnt">
            <div class="tnt-body">
                <span class="tnt-label">@Model.StatusCode</span>
            </div>
            <div class="spark"></div>
        </div>

        <!-- 错误标题 -->
        <div class="error-header">
            <h1 class="error-title">@Model.ErrorTitle</h1>
            <p class="error-desc">@Model.ErrorMessage</p>
        </div>

        <!-- 追踪 ID -->
        @if (!string.IsNullOrEmpty(Model.RequestId))
        {
            <div class="trace-id-block">
                <span class="label">追踪 ID:</span>
                <code class="id-code">@Model.RequestId</code>
            </div>
        }

        <!-- 操作按钮区 -->
        <div class="action-buttons">
            <a href="/" class="mc-button">
                <span class="btn-shadow"></span>
                <span class="btn-content">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M3 12l2-2v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7l2 2M7 12l5-5 5 5" />
                    </svg>
                    返回首页
                </span>
            </a>

            <button onclick="history.back()" class="mc-button secondary">
                <span class="btn-shadow"></span>
                <span class="btn-content">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M9 14L4 9l5-5M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5v0a5.5 5.5 0 0 1-5.5 5.5H11" />
                    </svg>
                    返回上一页
                </span>
            </button>
        </div>

        <!-- 详情面板（可折叠） -->
        @if (Model.ShowDetails && !string.IsNullOrEmpty(Model.ExceptionDetails))
        {
            <div class="details-section">
                <button onclick="toggleDetails()" class="details-toggle">
                    <span>查看错误详情</span>
                    <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M19 9l-7 7-7-7" />
                    </svg>
                </button>

                <div id="error-details" class="details-content hidden">
                    <div class="details-toolbar">
                        <span class="toolbar-title">异常堆栈</span>
                        <button onclick="copyDetails()" class="copy-btn">复制</button>
                    </div>
                    <pre><code>@Model.ExceptionDetails</code></pre>
                </div>
            </div>
        }

        <!-- 页脚信息 -->
        <div class="error-footer">
            <div class="footer-line">
                <span class="label">系统时间:</span>
                <span class="value">@DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss") UTC</span>
            </div>
            <div class="footer-line">
                <span class="label">版本:</span>
                <span class="value">F-MCSC v1.0.0</span>
            </div>
        </div>
    </div>

    <script src="~/js/Error.js" asp-append-version="true"></script>
</body>
</html>