@page
@model Fantasy.MinecraftServerConsole.Pages.LoginModel
@{
    ViewData["Title"] = "用户登录";
    Layout = null;
}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - F-MCSC</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700;900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/Login.css" asp-append-version="true" />
</head>
<body>

    <!-- Dirt 纹理背景 -->
    <div class="dirt-bg"></div>

    <!-- 登录容器 -->
    <div class="login-container">
        <!-- 角标 -->
        <div class="corner corner-tl"></div>
        <div class="corner corner-tr"></div>
        <div class="corner corner-bl"></div>
        <div class="corner corner-br"></div>

        <!-- Logo 区域 -->
        <div class="logo-section">
            <div class="mc-logo">
                <div class="logo-cube">
                    <div class="cube-face"></div>
                </div>
            </div>
            <h1 class="mc-title">用户登录</h1>
            <p class="mc-subtitle">F-MCSC 管理系统</p>
        </div>

        <!-- 登录表单 -->
        <form id="loginForm" class="mc-form">

            <!-- 用户名输入 -->
            <div class="input-block">
                <label class="block-label">用户名 / 邮箱</label>
                <div class="input-wrapper">
                    <div class="input-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>
                    </div>
                    <input type="text" id="username" class="mc-input" placeholder="请输入用户名" autocomplete="off">
                </div>
            </div>

            <!-- 密码输入 -->
            <div class="input-block">
                <label class="block-label">密码</label>
                <div class="input-wrapper">
                    <div class="input-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <rect x="3" y="11" width="18" height="11" rx="0" ry="0" />
                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                        </svg>
                    </div>
                    <input type="password" id="password" class="mc-input" placeholder="请输入密码">
                    <button type="button" id="togglePassword" class="toggle-btn">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" id="eyeIcon">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                    </button>
                </div>
            </div>

            <!-- 选项栏 -->
            <div class="options-row">
                <label class="mc-checkbox-wrapper">
                    <input type="checkbox" class="mc-checkbox" id="rememberMe">
                    <span class="checkmark"></span>
                    <span class="label-text">记住我</span>
                </label>
                <a href="#" class="link-text">忘记密码?</a>
            </div>

            <!-- 登录按钮 - 仿 MC 主菜单按钮 -->
            <button type="submit" id="loginBtn" class="mc-button primary">
                <span class="btn-shadow"></span>
                <span class="btn-content">
                    <span class="loading-spinner"></span>
                    <span class="btn-text">登 录</span>
                </span>
            </button>

        </form>

        <!-- 注册链接 -->
        <div class="footer-row">
            <span class="text-muted">还没有账户?</span>
            <a href="#" class="link-text highlight">创建账户</a>
        </div>
    </div>

    <script src="~/js/Login.js" asp-append-version="true"></script>
</body>
</html>